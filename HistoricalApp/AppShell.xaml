<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:HistoricalApp.Views"
    x:Class="HistoricalApp.AppShell"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <!-- LoginPage is FIRST so it's the default on startup -->
    <ShellContent Route="LoginPage"
                  ContentTemplate="{DataTemplate views:LoginPage}" />

    <ShellContent Route="RegisterPage"
                  ContentTemplate="{DataTemplate views:RegisterPage}" />

    <!-- Authenticated pages -->
    <ShellContent Route="HomePage"
                  ContentTemplate="{DataTemplate views:HomePage}" />

    <ShellContent Route="ProfilePage"
                  ContentTemplate="{DataTemplate views:ProfilePage}" />

    <ShellContent Route="LeaderboardPage"
                  ContentTemplate="{DataTemplate views:LeaderboardPage}" />

    <ShellContent Route="AdminPage"
                  ContentTemplate="{DataTemplate views:AdminPage}" />

    <ShellContent Route="QuizSelectionPage"
                  ContentTemplate="{DataTemplate views:QuizSelectionPage}" />

    <ShellContent Route="ShopPage"
                  ContentTemplate="{DataTemplate views:ShopPage}" />

    <ShellContent Route="CategorySelectionPage"
                  ContentTemplate="{DataTemplate views:CategorySelectionPage}" />

</Shell>
