<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="HistoricalApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:HistoricalApp.Views"
    Shell.FlyoutBehavior="Flyout"
    Title="HistoricalApp">

    <FlyoutItem Title="Login/Register" Icon="admin_icon.png">
        <ShellContent ContentTemplate="{DataTemplate local:LoginPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Admin Panel"
                Route="AdminPage"
                x:Name="AdminPanelItem"
                FlyoutDisplayOptions="AsSingleItem"
                Icon="admin.png"
                IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate local:AdminPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Profile"
                Route="ProfilePage"
                Icon="user.png">
        <ShellContent ContentTemplate="{DataTemplate local:ProfilePage}" />
    </FlyoutItem>

    <FlyoutItem Title="Leaderboard"
                Route="LeaderboardPage"
                Icon="trophy.png">
        <ShellContent ContentTemplate="{DataTemplate local:LeaderboardPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Categories"
             Route="CategorySelectionPage"
             Icon="Quiz.png">
        <ShellContent ContentTemplate="{DataTemplate local:CategorySelectionPage}" />
    </FlyoutItem>

</Shell>
