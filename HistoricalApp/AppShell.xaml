<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:HistoricalApp.Views"
    x:Class="HistoricalApp.AppShell"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <!-- TOP LEVEL ROUTES -->
    <ShellContent Route="HomePage"
                  ContentTemplate="{DataTemplate views:HomePage}" />

    <ShellContent Route="ProfilePage"
                  ContentTemplate="{DataTemplate views:ProfilePage}" />

    <ShellContent Route="LeaderboardPage"
                  ContentTemplate="{DataTemplate views:LeaderboardPage}" />

    <ShellContent Route="AdminPage"
                  ContentTemplate="{DataTemplate views:AdminPage}" />

</Shell>
