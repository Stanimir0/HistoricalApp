<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="HistoricalApp.Controls.BottomNavBar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root"
    HeightRequest="70"
    BackgroundColor="#111111">

    <Grid ColumnDefinitions="*,*,*,*"
          Padding="10,5"
          VerticalOptions="End">

        <!-- HOME -->
        <VerticalStackLayout Grid.Column="0"
                             HorizontalOptions="Center">
            <Image Source="icon_home.png"
                   WidthRequest="24"
                   HeightRequest="24">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHomeTapped" />
                </Image.GestureRecognizers>
            </Image>
            <Label Text="Home"
                   FontSize="11"
                   TextColor="White"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- PROFILE -->
        <VerticalStackLayout Grid.Column="1"
                             HorizontalOptions="Center">
            <Image Source="icon_profile.png"
                   WidthRequest="24"
                   HeightRequest="24">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnProfileTapped" />
                </Image.GestureRecognizers>
            </Image>
            <Label Text="Profile"
                   FontSize="11"
                   TextColor="White"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- LEADERBOARD -->
        <VerticalStackLayout Grid.Column="2"
                             HorizontalOptions="Center">
            <Image Source="icon_trophy.png"
                   WidthRequest="24"
                   HeightRequest="24">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLeaderboardTapped" />
                </Image.GestureRecognizers>
            </Image>
            <Label Text="Ranking"
                   FontSize="11"
                   TextColor="White"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- ADMIN (always shown for now) -->
        <VerticalStackLayout Grid.Column="3"
                             HorizontalOptions="Center">
            <Image Source="icon_admin.png"
                   WidthRequest="24"
                   HeightRequest="24">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAdminTapped" />
                </Image.GestureRecognizers>
            </Image>
            <Label Text="Admin"
                   FontSize="11"
                   TextColor="White"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

    </Grid>
</ContentView>
