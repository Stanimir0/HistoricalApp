<ContentView
    x:Class="HistoricalApp.Controls.BottomNavBar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="Root"
    HeightRequest="80"
    BackgroundColor="Transparent">

    <Border StrokeShape="RoundRectangle 20,20,0,0"
            BackgroundColor="{StaticResource Surface}"
            Stroke="{StaticResource PrimaryDark}"
            StrokeThickness="1"
            Padding="10,5"
            VerticalOptions="End"
            Shadow="{StaticResource Shadow}">
        
        <Grid ColumnDefinitions="*,*,*">

            <!-- HOME -->
            <VerticalStackLayout Grid.Column="0"
                                 Spacing="0"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center">
                
                <ImageButton Source="icon_home.png"
                             WidthRequest="40"
                             HeightRequest="40"
                             CornerRadius="20"
                             BackgroundColor="Transparent"
                             Clicked="OnHomeClicked">
                    <ImageButton.Behaviors>
                         <Toolkit:IconTintColorBehavior TintColor="{StaticResource Primary}" />
                    </ImageButton.Behaviors>
                </ImageButton>
                    
                <Label Text="Home"
                       FontSize="10"
                       TextColor="{StaticResource Primary}"
                       HorizontalOptions="Center"
                       InputTransparent="True"/>
            </VerticalStackLayout>

            <!-- PROFILE -->
            <VerticalStackLayout Grid.Column="1"
                                 Spacing="0"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center">
                
                <ImageButton Source="icon_profile.png"
                             WidthRequest="40"
                             HeightRequest="40"
                             CornerRadius="20"
                             BackgroundColor="Transparent"
                             Clicked="OnProfileClicked">
                    <!-- Be safer with images that might not exist or need tinting -->
                </ImageButton>

                <Label Text="Profile"
                       FontSize="10"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalOptions="Center"
                       InputTransparent="True"/>
            </VerticalStackLayout>

            <!-- LEADERBOARD -->
            <VerticalStackLayout Grid.Column="2"
                                 Spacing="0"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center">
                
                <ImageButton Source="icon_trophy.png"
                             WidthRequest="40"
                             HeightRequest="40"
                             CornerRadius="20"
                             BackgroundColor="Transparent"
                             Clicked="OnLeaderboardClicked"/>

                <Label Text="Ranking"
                       FontSize="10"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalOptions="Center"
                       InputTransparent="True"/>
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
