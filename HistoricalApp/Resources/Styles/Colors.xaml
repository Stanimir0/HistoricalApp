<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- PREMIUM PALETTE -->
    <!-- Gold Accents -->
    <Color x:Key="Primary">#D4AF37</Color>         <!-- Metallic Gold -->
    <Color x:Key="PrimaryDark">#B4942D</Color>    <!-- Darker Gold -->
    <Color x:Key="PrimaryLight">#F3E5AB</Color>   <!-- Champagne -->
    
    <!-- Backgrounds (Midnight Blue) -->
    <Color x:Key="BackgroundMain">#0F172A</Color> <!-- Deep Slate Blue -->
    <Color x:Key="Surface">#1E293B</Color>        <!-- Lighter Slate -->
    <Color x:Key="SurfaceHighlight">#334155</Color>
    
    <!-- Text -->
    <Color x:Key="TextPrimary">#F1F5F9</Color>    <!-- Slate 100 -->
    <Color x:Key="TextSecondary">#94A3B8</Color>  <!-- Slate 400 -->
    <Color x:Key="TextInverted">#0F172A</Color>   
    
    <!-- Status -->
    <Color x:Key="Error">#EF4444</Color>
    <Color x:Key="Success">#22C55E</Color>

    <!-- Legacy/Direct mappings to keep app running if key names match previous usage -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Gray200">#E2E8F0</Color>
    <Color x:Key="Gray500">#64748B</Color>
    <Color x:Key="Gray900">#0F172A</Color>
    <Color x:Key="Gray950">#020617</Color>
    
    <Color x:Key="Magenta">#FF00FF</Color>

</ResourceDictionary>
