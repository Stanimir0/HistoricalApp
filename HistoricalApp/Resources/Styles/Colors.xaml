<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- PREMIUM MIDNIGHT GOLD PALETTE -->
    
    <!-- Gold Accents -->
    <Color x:Key="Primary">#D4AF37</Color>         <!-- Metallic Gold -->
    <Color x:Key="PrimaryDark">#B4942D</Color>    <!-- Darker Gold -->
    <Color x:Key="PrimaryLight">#F3E5AB</Color>   <!-- Champagne -->
    
    <!-- Gradients -->
    <Color x:Key="PrimaryGradientStart">#D4AF37</Color>
    <Color x:Key="PrimaryGradientEnd">#8A6E0F</Color>
    
    <!-- Backgrounds (Deep Midnight) -->
    <Color x:Key="BackgroundMain">#05080F</Color> <!-- Almost Black Blue -->
    <Color x:Key="BackgroundGradientStart">#0F172A</Color> <!-- Deep Slate -->
    <Color x:Key="BackgroundGradientEnd">#020617</Color>   <!-- Abyssal Black -->
    
    <!-- Surfaces -->
    <Color x:Key="Surface">#1E293B</Color>        <!-- Standard Slate -->
    <Color x:Key="SurfaceHighlight">#334155</Color>
    <Color x:Key="GlassSurface">#1AFFFFFF</Color> <!-- Semi-transparent White for Glassmorphism -->
    <Color x:Key="GlassBorder">#33FFFFFF</Color>  <!-- Subtle White Border -->
    
    <!-- Text -->
    <Color x:Key="TextPrimary">#F8FAFC</Color>    <!-- Slate 50 -->
    <Color x:Key="TextSecondary">#94A3B8</Color>  <!-- Slate 400 -->
    <Color x:Key="TextGold">#FFD700</Color>       <!-- Bright Gold Text -->
    <Color x:Key="TextInverted">#020617</Color>   
    
    <!-- Status -->
    <Color x:Key="Error">#EF4444</Color>
    <Color x:Key="Success">#22C55E</Color>

    <!-- Legacy/Direct mappings -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Gray200">#E2E8F0</Color>
    <Color x:Key="Gray500">#64748B</Color>
    <Color x:Key="Gray900">#0F172A</Color>
    <Color x:Key="Gray950">#020617</Color>
    
    <Color x:Key="Magenta">#FF00FF</Color>

</ResourceDictionary>
