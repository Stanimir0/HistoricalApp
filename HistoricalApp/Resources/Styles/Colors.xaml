<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- GOLD ACCENT -->
    <Color x:Key="Primary">#FFD700</Color>
    <Color x:Key="Tertiary">#C0A000</Color>

    <!-- DARK UI COLORS -->
    <Color x:Key="Secondary">#333333</Color>
    <Color x:Key="BackgroundDark">#1E1E1E</Color>
    <Color x:Key="CardDark">#252525</Color>
    <Color x:Key="CardDarker">#2E2E2E</Color>

    <!-- TEXT -->
    <Color x:Key="TextPrimary">White</Color>
    <Color x:Key="TextSecondary">#CCCCCC</Color>
    <Color x:Key="TextFaded">#AAAAAA</Color>

</ResourceDictionary>
