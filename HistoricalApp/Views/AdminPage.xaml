<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:HistoricalApp.ViewModels"
    xmlns:controls="clr-namespace:HistoricalApp.Controls"
    xmlns:helpers="clr-namespace:HistoricalApp.Helpers"
    x:Class="HistoricalApp.Views.AdminPage"
    x:Name="AdminRoot"
    BackgroundColor="#1e1e1e"
    Title="Admin Panel">

    <ContentPage.BindingContext>
        <vm:AdminViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="*,Auto">

        <!-- MAIN CONTENT -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="20">

            <Button Text="{Binding Translations.Back}"
                    BackgroundColor="#333"
                    TextColor="White"
                    Clicked="OnBackClicked"
                    HorizontalOptions="Start"
                    WidthRequest="100"
                    Margin="0,0,0,10" />

            <Label Text="{Binding Translations.AdminPanel}"
                   FontSize="28"
                   TextColor="#FFD700"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

                <Button Text="{Binding Translations.AddNewQuiz}"
                        BackgroundColor="#FFD700"
                        TextColor="#1E1E1E"
                        CornerRadius="20"
                        Command="{Binding AddQuizCommand}" />

                <CollectionView ItemsSource="{Binding Quizzes}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BackgroundColor="#252525"
                                   CornerRadius="12"
                                   Padding="12"
                                   Margin="0,5">

                                <VerticalStackLayout Spacing="3">

                                    <Label Text="{Binding Title}"
                                           FontAttributes="Bold"
                                           FontSize="18"
                                           TextColor="White" />

                                    <Label Text="{Binding Description}"
                                           FontSize="13"
                                           TextColor="#CCCCCC" />

                                    <HorizontalStackLayout Spacing="12"
                                                           Margin="0,5,0,0">

                                        <Button Text="{Binding Source={x:Static helpers:TranslationService.Instance}, Path=Edit}"
                                                BackgroundColor="#FFD700"
                                                TextColor="#1E1E1E"
                                                CornerRadius="16"
                                                Command="{Binding BindingContext.EditQuizCommand, Source={x:Reference AdminRoot}}"
                                                CommandParameter="{Binding .}" />

                                        <Button Text="{Binding Source={x:Static helpers:TranslationService.Instance}, Path=Delete}"
                                                BackgroundColor="#FF4C4C"
                                                TextColor="White"
                                                CornerRadius="16"
                                                Command="{Binding BindingContext.DeleteQuizCommand, Source={x:Reference AdminRoot}}"
                                                CommandParameter="{Binding .}" />

                                    </HorizontalStackLayout>

                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- BOTTOM NAV BAR -->
        <controls:BottomNavBar Grid.Row="1"/>

    </Grid>
</ContentPage>

