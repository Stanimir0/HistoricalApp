<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HistoricalApp.Views.CategorySelectionPage"
             xmlns:helpers="clr-namespace:HistoricalApp.Helpers"
             BackgroundColor="#1e1e1e"
             Title="Categories">

    <VerticalStackLayout Padding="20" Spacing="20">

        <Button Text="{Binding Source={x:Static helpers:TranslationService.Instance}, Path=Back}"
                BackgroundColor="#333"
                TextColor="White"
                Clicked="OnBackClicked"
                HorizontalOptions="Start"
                WidthRequest="100"
                Margin="0,0,0,10" />

        <Label Text="{Binding Source={x:Static helpers:TranslationService.Instance}, Path=ChooseCategory}"
               FontSize="26"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="#FFD700" />

        <Button Text="{Binding Source={x:Static helpers:TranslationService.Instance}, Path=Battles}"
                BackgroundColor="#FFD700"
                TextColor="#1E1E1E"
                CornerRadius="20"
                Clicked="OnBattlesClicked" />

        <Button Text="{Binding Source={x:Static helpers:TranslationService.Instance}, Path=Events}"
                BackgroundColor="#FFD700"
                TextColor="#1E1E1E"
                CornerRadius="20"
                Clicked="OnEventsClicked" />

        <Button Text="{Binding Source={x:Static helpers:TranslationService.Instance}, Path=Characters}"
                BackgroundColor="#FFD700"
                TextColor="#1E1E1E"
                CornerRadius="20"
                Clicked="OnCharactersClicked" />

    </VerticalStackLayout>
</ContentPage>
