<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HistoricalApp.Views.CategorySelectionPage"
             BackgroundColor="#1e1e1e"
             Title="Categories">

    <VerticalStackLayout Padding="20" Spacing="20">

        <Label Text="Choose a Category"
               FontSize="26"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="#FFD700" />

        <Button Text="Battles"
                BackgroundColor="#FFD700"
                TextColor="#1E1E1E"
                CornerRadius="20"
                Clicked="OnBattlesClicked" />

        <Button Text="Events"
                BackgroundColor="#FFD700"
                TextColor="#1E1E1E"
                CornerRadius="20"
                Clicked="OnEventsClicked" />

        <Button Text="Characters"
                BackgroundColor="#FFD700"
                TextColor="#1E1E1E"
                CornerRadius="20"
                Clicked="OnCharactersClicked" />

    </VerticalStackLayout>
</ContentPage>
