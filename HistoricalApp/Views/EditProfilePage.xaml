<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:HistoricalApp.ViewModels"
             xmlns:helpers="clr-namespace:HistoricalApp.Helpers"
             x:Class="HistoricalApp.Views.EditProfilePage"
             Title="{Binding Translations.EditProfileTitle}"
             BackgroundColor="#1e1e1e">

    <ContentPage.Resources>
        <Style TargetType="Entry">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="PlaceholderColor" Value="#888" />
            <Setter Property="BackgroundColor" Value="#252525" />
        </Style>
        <Style TargetType="Editor">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="PlaceholderColor" Value="#888" />
            <Setter Property="BackgroundColor" Value="#252525" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">

            <!-- Profile Image Section -->
            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                <Frame CornerRadius="60"
                       HeightRequest="120"
                       WidthRequest="120"
                       Padding="0"
                       IsClippedToBounds="True"
                       BorderColor="#FFD700"
                       BackgroundColor="#1E1E1E">
                    
                    <Image Source="{Binding ProfileImageSource}"
                           Aspect="AspectFill"
                           HeightRequest="120"
                           WidthRequest="120"/>
                </Frame>

                <Button Text="{Binding Translations.ChangePhoto}"
                        FontSize="12"
                        HeightRequest="35"
                        BackgroundColor="#333"
                        TextColor="#FFD700"
                        Command="{Binding PickImageCommand}"
                        HorizontalOptions="Center"/>
            </VerticalStackLayout>


            <!-- Form Fields -->
            <VerticalStackLayout Spacing="5">
                <Label Text="{Binding Translations.Username}" TextColor="#FFD700" FontAttributes="Bold"/>
                <Entry Text="{Binding UserName}" Placeholder="{Binding Translations.UsernamePlaceholder}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="{Binding Translations.BioDescription}" TextColor="#FFD700" FontAttributes="Bold"/>
                <Editor Text="{Binding Description}" 
                        Placeholder="{Binding Translations.BioPlaceholder}" 
                        HeightRequest="100" />
            </VerticalStackLayout>

            <!-- Badge Selection Section -->
            <VerticalStackLayout Spacing="10" Margin="0,10,0,0">
                <Label Text="{Binding Translations.SelectBadge}" TextColor="#FFD700" FontAttributes="Bold"/>
                
                <CollectionView ItemsSource="{Binding PurchasedBadges}"
                                SelectionMode="None"
                                HeightRequest="80">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="15"
                                   CornerRadius="12"
                                   BorderColor="#FFD700"

                                   BackgroundColor="#252525"
                                   HasShadow="True">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:EditProfileViewModel}}, Path=SelectBadgeCommand}"
                                                          CommandParameter="{Binding .}"/>
                                </Frame.GestureRecognizers>
                                <Label Text="{Binding IconEmoji}"
                                       FontSize="32"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                         <Label Text="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:EditProfileViewModel}}, Path=Translations.NoBadgesPurchased}"
                               TextColor="#888"
                               FontSize="12"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </CollectionView.EmptyView>
                </CollectionView>

                <Button Text="{Binding Translations.RemoveBadge}"
                        BackgroundColor="#444"
                        TextColor="#FFD700"
                        FontSize="12"
                        HeightRequest="35"
                        Command="{Binding RemoveBadgeCommand}"
                        IsVisible="{Binding HasSelectedBadge}"
                        HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Border Selection Section -->
            <VerticalStackLayout Spacing="10" Margin="0,10,0,0">
                <Label Text="{Binding Translations.SelectBorder}" TextColor="#FFD700" FontAttributes="Bold"/>
                
                <CollectionView ItemsSource="{Binding PurchasedBorders}"
                                SelectionMode="None"
                                HeightRequest="80">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="15"
                                   CornerRadius="12"
                                   BorderColor="#FFD700"

                                   BackgroundColor="#252525"
                                   HasShadow="True">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:EditProfileViewModel}}, Path=SelectBorderCommand}"
                                                          CommandParameter="{Binding .}"/>
                                </Frame.GestureRecognizers>
                                <Label Text="{Binding IconEmoji}"
                                       FontSize="32"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                         <Label Text="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:EditProfileViewModel}}, Path=Translations.NoBordersPurchased}"
                               TextColor="#888"
                               FontSize="12"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </CollectionView.EmptyView>
                </CollectionView>

                <Button Text="{Binding Translations.RemoveBorder}"
                        BackgroundColor="#444"
                        TextColor="#FFD700"
                        FontSize="12"
                        HeightRequest="35"
                        Command="{Binding RemoveBorderCommand}"
                        IsVisible="{Binding HasSelectedBorder}"
                        HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Secret Badge Selection Section -->
            <VerticalStackLayout Spacing="10" Margin="0,10,0,0"
                                 IsVisible="{Binding HasSecretBadges}">
                <Label Text="{Binding Translations.EquipSecretBadge}" TextColor="#CE93D8" FontAttributes="Bold"/>
                
                <CollectionView ItemsSource="{Binding OwnedSecretBadges}"
                                SelectionMode="None"
                                HeightRequest="80">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="15"
                                   CornerRadius="12"
                                   BorderColor="#CE93D8"
                                   BackgroundColor="#252525"
                                   HasShadow="True">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:EditProfileViewModel}}, Path=SelectSecretBadgeCommand}"
                                                          CommandParameter="{Binding .}"/>
                                </Frame.GestureRecognizers>
                                <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="{Binding Emoji}"
                                           FontSize="28"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding Name}"
                                           FontSize="9"
                                           TextColor="#CE93D8"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Text="{Binding Translations.RemoveSecretBadge}"
                        BackgroundColor="#444"
                        TextColor="#CE93D8"
                        FontSize="12"
                        HeightRequest="35"
                        Command="{Binding RemoveSecretBadgeCommand}"
                        IsVisible="{Binding HasSelectedSecretBadge}"
                        HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Theme Selection Section -->
            <VerticalStackLayout Spacing="10" Margin="0,10,0,0">
                <Label Text="{Binding Translations.SelectTheme}" TextColor="#FFD700" FontAttributes="Bold"/>
                
                <CollectionView ItemsSource="{Binding PurchasedThemes}"
                                SelectionMode="None"
                                HeightRequest="90">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="10"
                                   CornerRadius="12"
                                   BorderColor="{DynamicResource Primary}"
                                   BackgroundColor="{DynamicResource SurfaceHighlight}"
                                   HasShadow="True"
                                   WidthRequest="100">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:EditProfileViewModel}}, Path=SelectThemeCommand}"
                                                          CommandParameter="{Binding .}"/>
                                </Frame.GestureRecognizers>
                                <VerticalStackLayout Spacing="5" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="{Binding IconEmoji}"
                                           FontSize="28"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding Name}"
                                           FontSize="11"
                                           TextColor="{DynamicResource TextPrimary}"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                         <Label Text="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:EditProfileViewModel}}, Path=Translations.NoThemesPurchased}"
                               TextColor="#888"
                               FontSize="12"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </CollectionView.EmptyView>
                </CollectionView>

                <Button Text="{Binding Translations.ResetTheme}"
                        BackgroundColor="#444"
                        TextColor="#FFD700"
                        FontSize="12"
                        HeightRequest="35"
                        Command="{Binding RemoveThemeCommand}"
                        IsVisible="{Binding HasSelectedTheme}"
                        HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Action Buttons -->
            <Button Text="{Binding Translations.SaveChanges}"
                    BackgroundColor="#FFD700"
                    TextColor="Black"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    Margin="0,20,0,0"
                    Command="{Binding SaveCommand}"/>

            <Button Text="{Binding Translations.Cancel}"
                    BackgroundColor="Transparent"
                    TextColor="#FF4444"
                    Command="{Binding CancelCommand}"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

