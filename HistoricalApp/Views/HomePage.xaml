<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:HistoricalApp.ViewModels"
    xmlns:controls="clr-namespace:HistoricalApp.Controls"
    xmlns:helpers="clr-namespace:HistoricalApp.Helpers"
    x:Class="HistoricalApp.Views.HomePage"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.BindingContext>
        <viewmodels:ProfileViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="*,80" RowSpacing="0">
        <!-- Main Scrollable Content -->
        <ScrollView Grid.Row="0" Grid.RowSpan="2" Padding="0,0,0,80" x:Name="HomeRoot" Opacity="0" TranslationY="100">
            <Grid RowDefinitions="Auto, Auto, *" RowSpacing="20" Padding="20,40,20,20">
                
                <!-- Hero Section -->
                <VerticalStackLayout Grid.Row="0" Spacing="5" Margin="0,10,0,30">
                    <Label Text="{Binding Translations.WelcomeBack}"
                           Style="{StaticResource SubHeadline}" 
                           HorizontalOptions="Start"
                           FontSize="18"
                           TextColor="{StaticResource Primary}"/>
                    
                    <Label Text="{Binding CurrentUser.UserName, TargetNullValue='Explorer'}"
                           Style="{StaticResource Headline}" 
                           HorizontalOptions="Start"
                           FontSize="36"
                           TextColor="{StaticResource TextPrimary}"/>
                </VerticalStackLayout>


                <!-- Game Modes Dashboard -->
                <Grid Grid.Row="2" ColumnDefinitions="*,*" RowDefinitions="160, 160" ColumnSpacing="15" RowSpacing="15">
                    
                    <!-- Battles Card -->
                    <Frame Grid.Row="0" Grid.Column="0" 
                           Style="{StaticResource Frame}">
                        <Frame.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource GlassSurface}" Offset="0.0" />
                                <GradientStop Color="#2AFFFFFF" Offset="1.0" />
                            </LinearGradientBrush>
                        </Frame.Background>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBattlesClicked"/>
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                            <Label Text="⚔️" FontSize="48" HorizontalOptions="Center"/>
                            <Label Text="{Binding Translations.Battles}" 
                                   FontAttributes="Bold" 
                                   FontSize="16"
                                   TextColor="{StaticResource TextPrimary}" 
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Events Card -->
                    <Frame Grid.Row="0" Grid.Column="1"
                           Style="{StaticResource Frame}">
                         <Frame.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource GlassSurface}" Offset="0.0" />
                                <GradientStop Color="#2AFFFFFF" Offset="1.0" />
                            </LinearGradientBrush>
                        </Frame.Background>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEventsClicked"/>
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                            <Label Text="📅" FontSize="48" HorizontalOptions="Center"/>
                            <Label Text="{Binding Translations.Events}" 
                                   FontAttributes="Bold" 
                                   FontSize="16"
                                   TextColor="{StaticResource TextPrimary}" 
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Characters Card -->
                    <Frame Grid.Row="1" Grid.Column="0"
                           Style="{StaticResource Frame}">
                         <Frame.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource GlassSurface}" Offset="0.0" />
                                <GradientStop Color="#2AFFFFFF" Offset="1.0" />
                            </LinearGradientBrush>
                        </Frame.Background>
                         <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCharactersClicked"/>
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                            <Label Text="👤" FontSize="48" HorizontalOptions="Center"/>
                            <Label Text="{Binding Translations.People}" 
                                   FontAttributes="Bold" 
                                   FontSize="16"
                                   TextColor="{StaticResource TextPrimary}" 
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Shop Shortcut -->
                    <Frame Grid.Row="1" Grid.Column="1"
                           Style="{StaticResource Frame}"
                           BorderColor="{StaticResource Primary}">
                         <Frame.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4D D4AF37" Offset="0.0" />
                                <GradientStop Color="{StaticResource GlassSurface}" Offset="1.0" />
                            </LinearGradientBrush>
                        </Frame.Background>
                         <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnShopClicked"/>
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                            <Label Text="🛒" FontSize="48" HorizontalOptions="Center"/>
                            <Label Text="{Binding Translations.Shop}" 
                                   FontAttributes="Bold" 
                                   FontSize="16"
                                   TextColor="{StaticResource TextGold}" 
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                </Grid>

            </Grid>
        </ScrollView>

        <!-- Custom NavBar -->
        <controls:BottomNavBar Grid.Row="1"/>
    </Grid>
</ContentPage>

