<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:HistoricalApp.ViewModels"
             x:Class="HistoricalApp.Views.HomePage"
             x:Name="HomeRoot"
             BackgroundColor="#1e1e1e"
             Title="Home">

    <ContentPage.BindingContext>
        <viewmodels:ProfileViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Welcome back,"
                   FontSize="18"
                   TextColor="#CCCCCC"/>

            <Label Text="{Binding CurrentUser.UserName}"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#FFD700" />

            <Frame BackgroundColor="#252525"
                   CornerRadius="16"
                   Padding="15"
                   Margin="0,10,0,10"
                   HasShadow="True">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Your Rank"
                           FontSize="14"
                           TextColor="#AAAAAA"/>

                    <Label Text="{Binding CurrentUser.Rank}"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#FFD700"/>

                    <Label Text="{Binding CurrentUser.TotalPoints, StringFormat='Total Points: {0}'}"
                           FontSize="14"
                           TextColor="#CCCCCC"/>
                </VerticalStackLayout>
            </Frame>

            <Label Text="Start a Quiz"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="#FFFFFF"/>

            <VerticalStackLayout Spacing="12">

                <Button Text="Battles Quizzes"
                        BackgroundColor="#FFD700"
                        TextColor="#1E1E1E"
                        CornerRadius="20"
                        Clicked="OnBattlesClicked"/>

                <Button Text="Events Quizzes"
                        BackgroundColor="#FFD700"
                        TextColor="#1E1E1E"
                        CornerRadius="20"
                        Clicked="OnEventsClicked"/>

                <Button Text="Characters Quizzes"
                        BackgroundColor="#FFD700"
                        TextColor="#1E1E1E"
                        CornerRadius="20"
                        Clicked="OnCharactersClicked"/>

            </VerticalStackLayout>

            <Button Text="View Leaderboard"
                    Margin="0,20,0,0"
                    BackgroundColor="#333333"
                    TextColor="White"
                    CornerRadius="20"
                    Clicked="OnLeaderboardClicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
