<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:HistoricalApp.ViewModels"
    xmlns:controls="clr-namespace:HistoricalApp.Controls"
    x:Class="HistoricalApp.Views.HomePage"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.BindingContext>
        <viewmodels:ProfileViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="*,80" RowSpacing="0">
        <!-- Main Scrollable Content -->
        <ScrollView Grid.Row="0" Grid.RowSpan="2" Padding="0,0,0,80" x:Name="HomeRoot" Opacity="0" TranslationY="100">
            <Grid RowDefinitions="Auto, Auto, *" RowSpacing="20" Padding="20,40,20,20">
                
                <!-- Header -->
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                    <VerticalStackLayout>
                        <Label Text="Welcome Back," Style="{StaticResource SubHeadline}" HorizontalOptions="Start"/>
                        <Label Text="{Binding CurrentUser.UserName, TargetNullValue='Explorer'}" 
                               Style="{StaticResource Headline}" 
                               HorizontalOptions="Start"
                               FontSize="24"/>
                    </VerticalStackLayout>
                    <!-- User Avatar or Icon could go here -->
                </Grid>

                <!-- Stats Card -->
                <Frame Grid.Row="1">
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                        <VerticalStackLayout>
                            <Label Text="RANK" TextColor="{StaticResource TextSecondary}" FontSize="12"/>
                            <Label Text="{Binding CurrentUser.Rank, TargetNullValue='Novice'}" 
                                   TextColor="{StaticResource Primary}" 
                                   FontAttributes="Bold" 
                                   FontSize="20"/>
                        </VerticalStackLayout>
                        
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="POINTS" TextColor="{StaticResource TextSecondary}" FontSize="12"/>
                            <Label Text="{Binding CurrentUser.TotalPoints, TargetNullValue='0'}" 
                                   TextColor="{StaticResource Primary}" 
                                   FontAttributes="Bold" 
                                   FontSize="20"/>
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

                <!-- Game Modes Dashboard -->
                <Grid Grid.Row="2" ColumnDefinitions="*,*" RowDefinitions="140, 140" ColumnSpacing="15" RowSpacing="15">
                    
                    <!-- Battles -->
                    <Frame Grid.Row="0" Grid.Column="0" 
                           BorderColor="{StaticResource PrimaryDark}"
                           BackgroundColor="{StaticResource SurfaceHighlight}">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateBattles}"/>
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                            <Label Text="⚔️" FontSize="40" HorizontalOptions="Center"/>
                            <Label Text="Battles" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" Margin="0,10,0,0"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Events -->
                    <Frame Grid.Row="0" Grid.Column="1"
                           BorderColor="{StaticResource PrimaryDark}"
                           BackgroundColor="{StaticResource SurfaceHighlight}">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateEvents}"/>
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                            <Label Text="📅" FontSize="40" HorizontalOptions="Center"/>
                            <Label Text="Events" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" Margin="0,10,0,0"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Characters -->
                    <Frame Grid.Row="1" Grid.Column="0"
                           BorderColor="{StaticResource PrimaryDark}"
                           BackgroundColor="{StaticResource SurfaceHighlight}">
                         <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateCharacters}"/>
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                            <Label Text="👤" FontSize="40" HorizontalOptions="Center"/>
                            <Label Text="People" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" Margin="0,10,0,0"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Leaderboard Shortcut -->
                    <Frame Grid.Row="1" Grid.Column="1"
                           BorderColor="{StaticResource PrimaryDark}"
                           BackgroundColor="{StaticResource SurfaceHighlight}">
                         <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLeaderboardClicked"/>
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                            <Label Text="🏆" FontSize="40" HorizontalOptions="Center"/>
                            <Label Text="Top 10" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" Margin="0,10,0,0"/>
                        </VerticalStackLayout>
                    </Frame>

                </Grid>

            </Grid>
        </ScrollView>

        <!-- Custom NavBar -->
        <controls:BottomNavBar Grid.Row="1"/>
    </Grid>
</ContentPage>
