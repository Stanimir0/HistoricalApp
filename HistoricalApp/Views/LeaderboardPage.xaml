<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:HistoricalApp.ViewModels"
             x:Class="HistoricalApp.Views.LeaderboardPage"
             BackgroundColor="#1e1e1e"
             Title="Leaderboard">

    <ContentPage.BindingContext>
        <viewmodels:LeaderboardViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="20">

            <Label Text="Leaderboard"
                   FontSize="28"
                   TextColor="#FFD700"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <CollectionView ItemsSource="{Binding Users}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="#2d2d2d"
                               CornerRadius="12"
                               Padding="15"
                               Margin="0,5">

                            <VerticalStackLayout>
                                <Label Text="{Binding UserName}" 
                                       FontSize="20" 
                                       TextColor="White" />

                                <Label Text="{Binding TotalPoints, StringFormat='Points: {0}'}"
                                       FontSize="14"
                                       TextColor="#ccc" />

                                <Label Text="{Binding Rank, StringFormat='Rank: {0}'}"
                                       FontSize="14"
                                       TextColor="#FFD700" />
                            </VerticalStackLayout>

                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
