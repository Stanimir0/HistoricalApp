<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:HistoricalApp.ViewModels"
    xmlns:controls="clr-namespace:HistoricalApp.Controls"
    xmlns:models="clr-namespace:HistoricalApp.Models"
    x:Class="HistoricalApp.Views.LeaderboardPage"
    BackgroundColor="#0E0E0E">

    <ContentPage.BindingContext>
        <viewmodels:LeaderboardViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="*,Auto">

        <!-- MAIN CONTENT -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout x:Name="RootLayout"
                                 Padding="25"
                                 Spacing="15">

                <Label Text="Leaderboard"
                       FontSize="32"
                       TextColor="#f1c40f"
                       FontAttributes="Bold"/>

                <CollectionView ItemsSource="{Binding Users}"
                                SelectionMode="None">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:User">
                            <Frame BackgroundColor="#1A1A1A"
                                   CornerRadius="15"
                                   Padding="15">

                                <VerticalStackLayout>
                                    <Label Text="{Binding UserName}"
                                           FontSize="22"
                                           TextColor="White"
                                           FontAttributes="Bold"/>

                                    <Label Text="Rank:"
                                           TextColor="#f1c40f"
                                           FontSize="14"/>
                                    <Label Text="{Binding Rank}"
                                           TextColor="White"
                                           FontSize="18"/>

                                    <Label Text="Points:"
                                           TextColor="#f1c40f"
                                           FontSize="14"/>
                                    <Label Text="{Binding TotalPoints}"
                                           TextColor="White"
                                           FontSize="18"/>
                                </VerticalStackLayout>

                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- BOTTOM NAV BAR -->
        <controls:BottomNavBar Grid.Row="1"/>

    </Grid>
</ContentPage>
