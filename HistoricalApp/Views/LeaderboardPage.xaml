<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:HistoricalApp.ViewModels"
    xmlns:controls="clr-namespace:HistoricalApp.Controls"
    xmlns:models="clr-namespace:HistoricalApp.Models"
    xmlns:helpers="clr-namespace:HistoricalApp.Helpers"
    x:Class="HistoricalApp.Views.LeaderboardPage"
    BackgroundColor="#0E0E0E">

    <ContentPage.BindingContext>
        <viewmodels:LeaderboardViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="*,Auto">

        <!-- MAIN CONTENT -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout x:Name="RootLayout"
                                 Padding="25"
                                 Spacing="15">

                <Label Text="{Binding Translations.Leaderboard}"
                       FontSize="32"
                       TextColor="#f1c40f"
                       FontAttributes="Bold"/>

                <CollectionView ItemsSource="{Binding Users}"
                                SelectionMode="None">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:LeaderboardItem">
                            <Border StrokeShape="RoundRectangle 15"
                                    StrokeThickness="0"
                                    BackgroundColor="#1A1A1A"
                                    Margin="0,0,0,10"
                                    Padding="15,10">
                                
                                <Grid ColumnDefinitions="40, 50, *, Auto" ColumnSpacing="15" VerticalOptions="Center">
                                    
                                    <!-- Position/Rank -->
                                    <Label Grid.Column="0" 
                                           Text="{Binding Position}"
                                           TextColor="{Binding RankColor}"
                                           FontSize="28"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                    
                                    <!-- Avatar Placeholder -->
                                    <Frame Grid.Column="1"
                                           HeightRequest="40"
                                           WidthRequest="40"
                                           CornerRadius="20"
                                           Padding="0"
                                           IsClippedToBounds="True"
                                           BackgroundColor="#333"
                                           BorderColor="{Binding RankColor}"
                                           HasShadow="False">
                                        <Image Source="icon_profile.png" Aspect="AspectFill" Margin="8"/>
                                    </Frame>

                                    <!-- User Info -->
                                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding User.UserName}"
                                               TextColor="White"
                                               FontSize="18"
                                               FontAttributes="Bold"/>
                                        <Label Text="{Binding User.Rank}"
                                               TextColor="{StaticResource TextSecondary}"
                                               FontSize="12"/>
                                    </VerticalStackLayout>

                                    <!-- Points -->
                                    <VerticalStackLayout Grid.Column="3" VerticalOptions="Center" HorizontalOptions="End">
                                        <Label Text="{Binding User.TotalPoints}"
                                               TextColor="#FFD700"
                                               FontSize="20"
                                               FontAttributes="Bold"
                                               HorizontalOptions="End"/>
                                        <Label Text="{Binding Source={x:Static helpers:TranslationService.Instance}, Path=Points}"
                                               TextColor="{StaticResource TextSecondary}"
                                               FontSize="10"
                                               HorizontalOptions="End"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- BOTTOM NAV BAR -->
        <controls:BottomNavBar Grid.Row="1"/>

    </Grid>
</ContentPage>

