<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:HistoricalApp.ViewModels"
             x:Class="HistoricalApp.Views.LeaderboardPage"
             BackgroundColor="#1e1e1e"
             Title="Leaderboard">

    <ContentPage.BindingContext>
        <viewmodels:LeaderboardViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="20" Spacing="20">

        <Label Text="Top Players"
               FontSize="26"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="#FFD700" />

        <CollectionView ItemsSource="{Binding Users}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame CornerRadius="12"
                           BackgroundColor="#252525"
                           Padding="15"
                           Margin="0,5">

                        <VerticalStackLayout Spacing="4">

                            <Label Text="{Binding UserName}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="White" />

                            <Label Text="{Binding Rank}"
                                   TextColor="#FFD700"
                                   FontSize="14" />

                            <Label Text="{Binding TotalPoints, StringFormat='Points: {0}'}"
                                   TextColor="#CCCCCC"
                                   FontSize="14" />

                        </VerticalStackLayout>

                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>
