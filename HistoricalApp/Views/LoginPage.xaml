<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HistoricalApp.ViewModels"
             x:Class="HistoricalApp.Views.LoginPage"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.BindingContext>
        <vm:LoginViewModel />
    </ContentPage.BindingContext>

    <Grid>
        <!-- Background Gradient (Optional, or just solid) -->
        <BoxView Color="{StaticResource BackgroundMain}" />

        <ScrollView>
            <VerticalStackLayout Spacing="25" Padding="30" VerticalOptions="Center" 
                                 x:Name="RootLayout" Opacity="0" TranslationY="100">

                <!-- Logo / Header -->
                <Label Text="Historical App" 
                       Style="{StaticResource Headline}" 
                       TextColor="{StaticResource Primary}"
                       Margin="0,0,0,10"/>
                
                <Label Text="Welcome Back" 
                       Style="{StaticResource SubHeadline}" 
                       Margin="0,0,0,30"/>

                <!-- Login Form Card -->
                <Frame Style="{StaticResource Frame}" Padding="20,30">
                    <VerticalStackLayout Spacing="15">
                        
                        <Label Text="Email" TextColor="{StaticResource TextSecondary}"/>
                        <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource PrimaryDark}" StrokeThickness="1" BackgroundColor="{StaticResource Surface}">
                            <Entry Placeholder="Enter your email" 
                                   Text="{Binding Email}" 
                                   Keyboard="Email"
                                   TextColor="{StaticResource TextPrimary}"
                                   PlaceholderColor="{StaticResource TextSecondary}"
                                   BackgroundColor="Transparent"/>
                        </Border>

                        <Label Text="Password" TextColor="{StaticResource TextSecondary}" Margin="0,10,0,0"/>
                        <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource PrimaryDark}" StrokeThickness="1" BackgroundColor="{StaticResource Surface}">
                            <Entry Placeholder="Enter your password" 
                                   Text="{Binding Password}" 
                                   IsPassword="True"
                                   TextColor="{StaticResource TextPrimary}"
                                   PlaceholderColor="{StaticResource TextSecondary}"
                                   BackgroundColor="Transparent"/>
                        </Border>

                        <Button Text="LOGIN" 
                                Command="{Binding LoginCommand}" 
                                Clicked="OnLoginClicked"
                                Margin="0,20,0,0"/>

                    </VerticalStackLayout>
                </Frame>

                <!-- Footer -->
                <Label Text="Don't have an account?" 
                       TextColor="{StaticResource TextSecondary}" 
                       HorizontalOptions="Center"
                       Margin="0,20,0,0"/>

                <Button Text="Create Account" 
                        Style="{StaticResource SecondaryButton}" 
                        Command="{Binding GoToRegisterCommand}" 
                        Clicked="OnGoToRegisterClicked"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
