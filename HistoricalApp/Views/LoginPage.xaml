<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HistoricalApp.ViewModels"
             xmlns:helpers="clr-namespace:HistoricalApp.Helpers"
             x:Class="HistoricalApp.Views.LoginPage"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.BindingContext>
        <vm:LoginViewModel />
    </ContentPage.BindingContext>

    <Grid>
        <!-- Background Gradient (Optional, or just solid) -->
        <BoxView Color="{StaticResource BackgroundMain}" />

        <ScrollView>
            <VerticalStackLayout Spacing="25" Padding="30" VerticalOptions="Center" 
                                 x:Name="RootLayout" Opacity="0" TranslationY="100">

                <!-- Logo / Header -->
                <Label Text="{Binding Translations.HistoricalApp}" 
                       Style="{StaticResource Headline}" 
                       TextColor="{StaticResource Primary}"
                       Margin="0,0,0,10"/>
                
                <Label Text="{Binding Translations.WelcomeBackTitle}" 
                       Style="{StaticResource SubHeadline}" 
                       Margin="0,0,0,30"/>

                <!-- Login Form Card -->
                <Frame Style="{StaticResource Frame}" Padding="25,35" CornerRadius="24">
                    <Frame.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource GlassSurface}" Offset="0.0" />
                            <GradientStop Color="#1AFFFFFF" Offset="1.0" />
                        </LinearGradientBrush>
                    </Frame.Background>
                    
                    <VerticalStackLayout Spacing="20">
                        
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Translations.Email}" 
                                   TextColor="{StaticResource TextSecondary}"
                                   FontSize="14"
                                   FontAttributes="Bold"/>
                            <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="Transparent">
                                <Entry Placeholder="{Binding Translations.EmailPlaceholder}" 
                                       Text="{Binding Email}" 
                                       Keyboard="Email"
                                       Style="{StaticResource Entry}"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Translations.Password}" 
                                   TextColor="{StaticResource TextSecondary}" 
                                   FontSize="14"
                                   FontAttributes="Bold"/>
                            <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="Transparent">
                                <Entry Placeholder="{Binding Translations.PasswordPlaceholder}" 
                                       Text="{Binding Password}" 
                                       IsPassword="True" 
                                       Style="{StaticResource Entry}"/>
                            </Border>
                        </VerticalStackLayout>


                        <Button Text="{Binding Translations.Login}" 
                                Command="{Binding LoginCommand}" 
                                Clicked="OnLoginClicked"
                                Margin="0,10,0,0"/>

                    </VerticalStackLayout>
                </Frame>

                <!-- Footer -->
                <Label Text="{Binding Translations.DontHaveAccount}" 
                       TextColor="{StaticResource TextSecondary}" 
                       HorizontalOptions="Center"
                       Margin="0,20,0,0"/>

                <Button Text="{Binding Translations.CreateAccount}" 
                        Style="{StaticResource SecondaryButton}" 
                        Command="{Binding GoToRegisterCommand}" 
                        Clicked="OnGoToRegisterClicked"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>

