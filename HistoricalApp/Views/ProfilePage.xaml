<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:HistoricalApp.ViewModels"
    xmlns:controls="clr-namespace:HistoricalApp.Controls"
    x:Class="HistoricalApp.Views.ProfilePage"
    BackgroundColor="#1e1e1e"
    Title="Profile">

    <ContentPage.BindingContext>
        <viewmodels:ProfileViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="*,Auto">

        <!-- MAIN CONTENT -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="20">

                <Label Text="Your Profile"
                       FontSize="26"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="#FFD700" />

                <Frame BackgroundColor="#252525"
                       CornerRadius="16"
                       Padding="20"
                       HasShadow="True">

                    <VerticalStackLayout Spacing="10">

                        <!-- Profile Image Section -->
                        <Grid ColumnDefinitions="*,Auto" HorizontalOptions="Center" WidthRequest="200">
                             <Frame CornerRadius="50"
                                    HeightRequest="100"
                                    WidthRequest="100"
                                    Padding="0"
                                    IsClippedToBounds="True"
                                    HorizontalOptions="Center"
                                    BorderColor="#FFD700"
                                    BackgroundColor="#1E1E1E">
                                    
                                <Image Source="{Binding UserProfileImageSource}"
                                       Aspect="AspectFill"
                                       HeightRequest="100"
                                       WidthRequest="100"/>
                            </Frame>

                            <Button Text="Edit Profile"
                                    Grid.Column="1"
                                    VerticalOptions="End"
                                    FontSize="10"
                                    HeightRequest="30"
                                    Padding="5,0"
                                    BackgroundColor="#FFD700"
                                    TextColor="Black"
                                    Command="{Binding EditProfileCommand}"
                                    Margin="-30,0,0,0"/> 
                        </Grid>

                        <BoxView Color="#444" HeightRequest="1" Margin="0,10" />

                        <Label Text="User Name"
                               TextColor="#AAAAAA"
                               FontSize="14" />

                        <Label Text="{Binding CurrentUser.UserName, FallbackValue='Loading...', TargetNullValue='Guest'}"
                               TextColor="White"
                               FontSize="20"
                               FontAttributes="Bold" />

                        <Label Text="Rank"
                               TextColor="#AAAAAA"
                               FontSize="14" />

                        <Label Text="{Binding CurrentUser.Rank, FallbackValue='Loading...', TargetNullValue='Novice'}"
                               TextColor="#FFD700"
                               FontSize="20"
                               FontAttributes="Bold" />

                        <Label Text="Total Points"
                               TextColor="#AAAAAA"
                               FontSize="14" />

                        <Label Text="{Binding CurrentUser.TotalPoints, FallbackValue='Loading...', TargetNullValue='0'}"
                               TextColor="White"
                               FontSize="20"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>

                </Frame>

                <Button Text="Admin Panel"
                        BackgroundColor="#FFD700"
                        TextColor="#1E1E1E"
                        Command="{Binding AdminPanelCommand}"
                        IsVisible="{Binding IsAdmin}"
                        Margin="0,20,0,0" />

                <Button Text="Logout"
                        BackgroundColor="#e53935"
                        TextColor="White"
                        Command="{Binding LogoutCommand}"
                        Margin="0,20,0,0" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- BOTTOM NAV BAR -->
        <controls:BottomNavBar Grid.Row="1"/>

    </Grid>
</ContentPage>
