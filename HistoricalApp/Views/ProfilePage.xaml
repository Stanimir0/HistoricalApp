<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:HistoricalApp.ViewModels"
             x:Class="HistoricalApp.Views.ProfilePage"
             BackgroundColor="#1e1e1e"
             Title="Profile">

    <ContentPage.BindingContext>
        <viewmodels:ProfileViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Your Profile"
                   FontSize="26"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#FFD700" />

            <Frame BackgroundColor="#252525"
                   CornerRadius="16"
                   Padding="20"
                   HasShadow="True">

                <VerticalStackLayout Spacing="10">

                    <Label Text="User Name"
                           TextColor="#AAAAAA"
                           FontSize="14" />

                    <Label Text="{Binding CurrentUser.UserName}"
                           TextColor="White"
                           FontSize="20"
                           FontAttributes="Bold" />

                    <Label Text="Rank"
                           TextColor="#AAAAAA"
                           FontSize="14" />

                    <Label Text="{Binding CurrentUser.Rank}"
                           TextColor="#FFD700"
                           FontSize="20"
                           FontAttributes="Bold" />

                    <Label Text="Total Points"
                           TextColor="#AAAAAA"
                           FontSize="14" />

                    <Label Text="{Binding CurrentUser.TotalPoints}"
                           TextColor="White"
                           FontSize="20"
                           FontAttributes="Bold" />
                </VerticalStackLayout>

            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
