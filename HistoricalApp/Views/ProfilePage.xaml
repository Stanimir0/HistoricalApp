<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:HistoricalApp.ViewModels"
    xmlns:controls="clr-namespace:HistoricalApp.Controls"
    x:Class="HistoricalApp.Views.ProfilePage"
    BackgroundColor="#1e1e1e"
    Title="Profile">

    <ContentPage.BindingContext>
        <viewmodels:ProfileViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="*,Auto">

        <!-- MAIN CONTENT -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="20">

                <Label Text="{Binding Translations.YourProfile}"
                       FontSize="26"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="#FFD700" />

                <Frame BackgroundColor="#252525"
                       CornerRadius="16"
                       Padding="20"
                       HasShadow="True">

                    <Grid RowDefinitions="Auto,*">
                        <!-- Edit Button - Top Right Corner -->
                        <Button Text="✏️ Edit"
                                Grid.Row="0"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                FontSize="12"
                                HeightRequest="32"
                                WidthRequest="70"
                                Padding="8,0"
                                CornerRadius="8"
                                BackgroundColor="#FFD700"
                                TextColor="Black"
                                Command="{Binding EditProfileCommand}"
                                Margin="0,0,0,10" />

                        <!-- Profile Content -->
                        <VerticalStackLayout Grid.Row="1" Spacing="10">

                            <!-- Profile Image Section -->
                            <Frame CornerRadius="50"
                                   HeightRequest="100"
                                   WidthRequest="100"
                                   Padding="0"
                                   IsClippedToBounds="True"
                                   HorizontalOptions="Center"
                                   BorderColor="#FFD700"
                                   BackgroundColor="#1E1E1E">
                                
                                <Image Source="{Binding UserProfileImageSource}"
                                       Aspect="AspectFill"
                                       HeightRequest="100"
                                       WidthRequest="100"/>
                            </Frame>

                            <BoxView Color="#444" HeightRequest="1" Margin="0,10" />

                            <Label Text="{Binding Translations.UserName}"
                                   TextColor="#AAAAAA"
                                   FontSize="14" />

                            <Label Text="{Binding CurrentUser.UserName, FallbackValue='Loading...', TargetNullValue='Guest'}"
                                   TextColor="White"
                                   FontSize="20"
                                   FontAttributes="Bold" />

                            <Label Text="{Binding Translations.Rank}"
                                   TextColor="#AAAAAA"
                                   FontSize="14" />

                            <Label Text="{Binding CurrentUser.Rank, FallbackValue='Loading...', TargetNullValue='Novice'}"
                                   TextColor="#FFD700"
                                   FontSize="20"
                                   FontAttributes="Bold" />

                            <Label Text="{Binding Translations.TotalPoints}"
                                   TextColor="#AAAAAA"
                                   FontSize="14" />

                            <Label Text="{Binding CurrentUser.TotalPoints, FallbackValue='Loading...', TargetNullValue='0'}"
                                   TextColor="White"
                                   FontSize="20"
                                   FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Grid>

                </Frame>

                <Button Text="{Binding Translations.AdminPanel}"
                        BackgroundColor="#FFD700"
                        TextColor="#1E1E1E"
                        Command="{Binding AdminPanelCommand}"
                        IsVisible="{Binding IsAdmin}"
                        Margin="0,20,0,0" />

                <!-- Language Selector -->
                <Frame BackgroundColor="#252525"
                       CornerRadius="12"
                       Padding="15"
                       HasShadow="True"
                       Margin="0,20,0,0">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Language / Език"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#FFD700" />
                        
                        <Picker SelectedItem="{Binding SelectedLanguage}"
                                TextColor="White"
                                BackgroundColor="#1E1E1E">
                            <Picker.Items>
                                <x:String>English</x:String>
                                <x:String>Български</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>
                </Frame>

                <Button Text="{Binding Translations.Logout}"
                        BackgroundColor="#e53935"
                        TextColor="White"
                        Command="{Binding LogoutCommand}"
                        Margin="0,20,0,0" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- BOTTOM NAV BAR -->
        <controls:BottomNavBar Grid.Row="1"/>

    </Grid>
</ContentPage>
