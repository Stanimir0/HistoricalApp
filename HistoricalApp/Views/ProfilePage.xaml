<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:HistoricalApp.ViewModels"
    xmlns:controls="clr-namespace:HistoricalApp.Controls"
    x:Class="HistoricalApp.Views.ProfilePage"
    BackgroundColor="#1e1e1e"
    Title="Profile">

    <ContentPage.BindingContext>
        <viewmodels:ProfileViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="*,Auto">

        <!-- MAIN CONTENT -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="20">

                <Label Text="{Binding Translations.YourProfile}"
                       FontSize="26"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="#FFD700" />

                <!-- Profile Header Card -->
                <Frame Style="{StaticResource Frame}" 
                       CornerRadius="24"
                       Padding="0"
                       IsClippedToBounds="True">
                    <Grid>
                        <!-- Glass Background -->
                        <BoxView>
                            <BoxView.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{StaticResource GlassSurface}" Offset="0.0" />
                                    <GradientStop Color="#1AFFFFFF" Offset="1.0" />
                                </LinearGradientBrush>
                            </BoxView.Background>
                        </BoxView>

                        <Grid RowDefinitions="Auto, Auto, Auto" Padding="20">
                            
                            <!-- Edit Button -->
                            <Button Text="{Binding Translations.EditProfile}"
                                    Grid.Row="0"
                                    HorizontalOptions="End"
                                    VerticalOptions="Start"
                                    FontSize="12"
                                    HeightRequest="36"
                                    Padding="15,0"
                                    CornerRadius="18"
                                    BackgroundColor="{StaticResource GlassSurface}"
                                    TextColor="{StaticResource Primary}"
                                    BorderColor="{StaticResource Primary}"
                                    BorderWidth="1"
                                    Command="{Binding EditProfileCommand}"
                                    Margin="0,0,0,10" />

                            <!-- Avatar & Name -->
                            <VerticalStackLayout Grid.Row="1" Spacing="15" HorizontalOptions="Center">
                                <Frame CornerRadius="60"
                                       HeightRequest="120"
                                       WidthRequest="120"
                                       Padding="0"
                                       IsClippedToBounds="True"
                                       BorderColor="{Binding ProfileBorderColor}"
                                       BackgroundColor="{StaticResource BackgroundMain}">
                                    <Image Source="{Binding UserProfileImageSource}"
                                           Aspect="AspectFill"
                                           HeightRequest="120"
                                           WidthRequest="120"/>
                                </Frame>

                                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                        <Label Text="{Binding CurrentUser.UserName, FallbackValue='Loading...', TargetNullValue='Guest'}"
                                               Style="{StaticResource Headline}"
                                               FontSize="24"/>
                                        <Label Text="{Binding BadgeEmoji}"
                                               FontSize="20"
                                               IsVisible="{Binding HasBadge}"
                                               VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                    
                                    <Label Text="{Binding CurrentUser.Rank, FallbackValue='Loading...', TargetNullValue='Novice'}"
                                           TextColor="{StaticResource TextGold}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <!-- Stats Row -->
                            <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,30,0,10">
                                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="5">
                                    <Label Text="{Binding Translations.TotalPoints}" 
                                           TextColor="{StaticResource TextSecondary}" 
                                           FontSize="12"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding CurrentUser.TotalPoints, FallbackValue='Loading...', TargetNullValue='0'}"
                                           TextColor="{StaticResource TextPrimary}"
                                           FontSize="24"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                                
                                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="5">
                                    <Label Text="{Binding Translations.Rank}" 
                                           TextColor="{StaticResource TextSecondary}" 
                                           FontSize="12"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding CurrentUser.Rank}"
                                           TextColor="{StaticResource TextPrimary}"
                                           FontSize="24"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Grid>

                        </Grid>
                    </Grid>
                </Frame>

                <Button Text="{Binding Translations.AdminPanel}"
                        BackgroundColor="#FFD700"
                        TextColor="#1E1E1E"
                        Command="{Binding AdminPanelCommand}"
                        IsVisible="{Binding IsAdmin}"
                        Margin="0,20,0,0" />

                <!-- Language Selector -->
                <Frame BackgroundColor="#252525"
                       CornerRadius="12"
                       Padding="15"
                       HasShadow="True"
                       Margin="0,20,0,0">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Language / Език"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#FFD700" />
                        
                        <Picker SelectedItem="{Binding SelectedLanguage}"
                                TextColor="White"
                                BackgroundColor="#1E1E1E">
                            <Picker.Items>
                                <x:String>English</x:String>
                                <x:String>Български</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>
                </Frame>

                <Button Text="{Binding Translations.Logout}"
                        BackgroundColor="#e53935"
                        TextColor="White"
                        Command="{Binding LogoutCommand}"
                        Margin="0,20,0,0" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- BOTTOM NAV BAR -->
        <controls:BottomNavBar Grid.Row="1"/>

    </Grid>
</ContentPage>

