<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup  
   xmlns="http://schemas.microsoft.com/dotnet/2021/maui"  
   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"  
   xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"  
 xmlns:viewmodels="clr-namespace:HistoricalApp.ViewModels;assembly=HistoricalApp"   
   x:Class="HistoricalApp.Views.QuestionManagerPopup"  
   BackgroundColor="#1e1e1e">  

   <VerticalStackLayout Padding="20" Spacing="10"  
                        WidthRequest="400"  
                        HeightRequest="600">  

       <Label Text="Manage Questions"  
              FontSize="22"  
              FontAttributes="Bold"  
              TextColor="#FFD700"  
              HorizontalOptions="Center" />  

       <CollectionView ItemsSource="{Binding Questions}">  
           <CollectionView.ItemTemplate>  
               <DataTemplate>  
                   <Frame BackgroundColor="#2d2d2d"  
                          CornerRadius="12"  
                          Padding="10"  
                          Margin="0,5">  
                       <VerticalStackLayout>  
                           <Label Text="{Binding Text}" TextColor="White" FontSize="16" />  
                           <Label Text="Answers:" TextColor="#ccc" FontSize="12" />  
                           <Label Text="{Binding Answers[0]}" TextColor="#ccc" FontSize="12" />  
                           <Label Text="{Binding Answers[1]}" TextColor="#ccc" FontSize="12" />  
                           <Label Text="{Binding Answers[2]}" TextColor="#ccc" FontSize="12" />  
                           <Label Text="{Binding Answers[3]}" TextColor="#ccc" FontSize="12" />  
                           <Label Text="{Binding CorrectAnswerIndex, StringFormat='Correct Answer: {0}'}"  
                                  TextColor="#FFD700"  
                                  FontSize="12" />  

                           <HorizontalStackLayout Spacing="10" HorizontalOptions="End">  
                               <Button Text="Edit"  
                                       BackgroundColor="#007bff"  
                                       TextColor="White"  
                                       Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:QuestionManagerViewModel}}, Path=EditQuestionCommand}"  
                                       CommandParameter="{Binding .}" />  
                               <Button Text="Delete"  
                                       BackgroundColor="#e53935"  
                                       TextColor="White"  
                                       Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:QuestionManagerViewModel}}, Path=DeleteQuestionCommand}"  
                                       CommandParameter="{Binding .}" />  
                           </HorizontalStackLayout>  
                       </VerticalStackLayout>  
                   </Frame>  
               </DataTemplate>  
           </CollectionView.ItemTemplate>  
       </CollectionView>  

       <Button Text="Add Question"  
               BackgroundColor="#28a745"  
               TextColor="White"  
               Command="{Binding AddQuestionCommand}" />  

       <Button Text="Close"  
               BackgroundColor="#555"  
               TextColor="White"  
               Clicked="OnCloseClicked" />  
   </VerticalStackLayout>  
</toolkit:Popup>
