<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:HistoricalApp.ViewModels"
             xmlns:helpers="clr-namespace:HistoricalApp.Helpers"
             x:Class="HistoricalApp.Views.QuizInfoPage"
             BackgroundColor="#1e1e1e"
             Title="{Binding Source={x:Static helpers:TranslationService.Instance}, Path=QuizInfoPageTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="15">

            <Label Text="{Binding Quiz.Title}"
                   FontAttributes="Bold"
                   FontSize="28"
                   TextColor="#FFD700"
                   HorizontalOptions="Center" />

            <Label Text="{Binding Quiz.Description}"
                   FontSize="16"
                   TextColor="White"
                   LineBreakMode="WordWrap"
                   HorizontalTextAlignment="Center" />

            <BoxView HeightRequest="1" Color="#444" />

            <Label TextColor="#ccc" FontSize="14">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding Source={x:Static helpers:TranslationService.Instance}, Path=Battles}" />
                        <Span Text=": " />
                        <Span Text="{Binding Quiz.Category}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <Label TextColor="#ccc" FontSize="14">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding Source={x:Static helpers:TranslationService.Instance}, Path=Points}" />
                        <Span Text=": " />
                        <Span Text="{Binding Quiz.Difficulty}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <Label TextColor="#ccc" FontSize="14">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding Source={x:Static helpers:TranslationService.Instance}, Path=Points}" />
                        <Span Text=": " />
                        <Span Text="{Binding Quiz.Points}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <BoxView HeightRequest="1" Color="#444" />

            <Button Text="{Binding Source={x:Static helpers:TranslationService.Instance}, Path=StartQuiz}"
                    BackgroundColor="#007bff"
                    TextColor="White"
                    Command="{Binding StartQuizCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
