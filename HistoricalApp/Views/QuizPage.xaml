<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:HistoricalApp.ViewModels"
             x:Class="HistoricalApp.Views.QuizPage"
             x:Name="RootQuizPage"
             BackgroundColor="#1e1e1e"
             Title="Quiz">

    <ContentPage.BindingContext>
        <viewmodels:QuizPlayViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="20" Spacing="20">

        <Label Text="{Binding CurrentQuizTitle}"
               FontSize="24"
               FontAttributes="Bold"
               TextColor="#FFD700"
               HorizontalOptions="Center" />

        <Label Text="{Binding CurrentQuestion.Text}"
               FontSize="18"
               TextColor="White"
               Margin="0,10,0,0" />

        <Label Text="{Binding QuestionProgress}"
               FontSize="14"
               TextColor="#BBBBBB"
               HorizontalOptions="Center" />

        <Frame BackgroundColor="#252525"
               CornerRadius="12"
               Padding="10"
               Margin="0,10,0,0">
            <VerticalStackLayout Spacing="10">

                <CollectionView ItemsSource="{Binding CurrentQuestion.Answers}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BackgroundColor="#333333"
                                   CornerRadius="10"
                                   Padding="12"
                                   Margin="0,5">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BindingContext.SelectAnswerCommand, Source={x:Reference RootQuizPage}}"
                                                          CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>
                                <Label Text="{Binding .}"
                                       TextColor="White" />
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Text="Next"
                        Command="{Binding NextQuestionCommand}"
                        BackgroundColor="#FFD700"
                        TextColor="#1E1E1E"
                        CornerRadius="20"
                        IsVisible="{Binding IsNextButtonVisible}" />

            </VerticalStackLayout>
        </Frame>

    </VerticalStackLayout>
</ContentPage>
