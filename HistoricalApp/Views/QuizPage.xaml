<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:HistoricalApp.ViewModels"
    xmlns:models="clr-namespace:HistoricalApp.Models"
    xmlns:helpers="clr-namespace:HistoricalApp.Helpers"
    x:Class="HistoricalApp.Views.QuizPage"
    BackgroundColor="#0E0E0E">

    <Grid x:Name="RootLayout" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Header: Title + Score -->
        <Grid Grid.Row="0" Padding="20,40,20,10" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Grid.Column="0">
                <Label Text="{Binding CurrentQuizTitle}"
                       FontSize="22"
                       TextColor="#f1c40f"
                       FontAttributes="Bold"
                       LineBreakMode="TailTruncation"/>
                <Label Text="{Binding QuestionProgress}"
                       TextColor="#888"
                       FontSize="13" />
            </VerticalStackLayout>

            <!-- Score Display -->
            <Border Grid.Column="1"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1"
                    Stroke="#333"
                    BackgroundColor="#1A1A1A"
                    Padding="12,8"
                    VerticalOptions="Center">
                <HorizontalStackLayout Spacing="5">
                    <Label Text="⭐" FontSize="16" VerticalOptions="Center"/>
                    <Label Text="{Binding Score}"
                           TextColor="#f1c40f"
                           FontSize="18"
                           FontAttributes="Bold"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- Progress Bar -->
        <ProgressBar Grid.Row="1"
                     Progress="{Binding QuestionProgressValue}"
                     ProgressColor="#f1c40f"
                     BackgroundColor="#222"
                     HeightRequest="6"
                     Margin="20,0"/>

        <!-- Timer (visible only for timed quizzes) -->
        <Border Grid.Row="2"
                StrokeShape="RoundRectangle 20"
                StrokeThickness="2"
                Stroke="{Binding TimerColor}"
                BackgroundColor="#1A1A1A"
                Padding="20,8"
                HorizontalOptions="Center"
                Margin="0,10"
                IsVisible="{Binding IsTimeBased}">
            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Label Text="⏱️" FontSize="20" VerticalOptions="Center"/>
                <Label Text="{Binding RemainingTime, StringFormat='{0}s'}"
                       TextColor="{Binding TimerColor}"
                       FontSize="24"
                       FontAttributes="Bold"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Border>

        <!-- Question + Answers -->
        <ScrollView Grid.Row="3" Margin="20,10">
            <VerticalStackLayout Spacing="15">

                <!-- Question Card -->
                <Border StrokeShape="RoundRectangle 18"
                        StrokeThickness="1"
                        Stroke="#333"
                        BackgroundColor="#161616"
                        Padding="22">
                    <Label Text="{Binding CurrentQuestion.Text}"
                           TextColor="White"
                           FontSize="20"
                           LineBreakMode="WordWrap"/>
                </Border>

                <!-- Double Points Active Banner -->
                <Border StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        BackgroundColor="#33FFD700"
                        Padding="10,6"
                        HorizontalOptions="Center"
                        IsVisible="{Binding IsDoublePointsActive}">
                    <Label Text="✨ DOUBLE POINTS ACTIVE ✨"
                           TextColor="#FFD700"
                           FontSize="13"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>
                </Border>

                <!-- Answer Options -->
                <CollectionView ItemsSource="{Binding VisibleAnswers}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:AnswerOption">
                            <Border StrokeShape="RoundRectangle 15"
                                    StrokeThickness="1"
                                    Stroke="#333"
                                    BackgroundColor="{Binding BackgroundColor}"
                                    Padding="16"
                                    Margin="0,4"
                                    IsVisible="{Binding IsVisible}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnAnswerTapped"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:QuizPlayViewModel}}, Path=SelectAnswerCommand}"
                                        CommandParameter="{Binding Text}" />
                                </Border.GestureRecognizers>

                                <Label Text="{Binding Text}"
                                       TextColor="{Binding TextColor}"
                                       FontSize="17"/>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Hint Buttons Bar -->
        <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="12" Padding="20,10,20,25">

            <!-- 50/50 Hint -->
            <Button Grid.Column="0"
                    Command="{Binding UseFiftyFiftyCommand}"
                    IsEnabled="{Binding HasFiftyFifty}"
                    BackgroundColor="#1A1A1A"
                    TextColor="#f1c40f"
                    CornerRadius="15"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    BorderColor="#333"
                    BorderWidth="1">
                <Button.Text>
                    <Binding Path="FiftyFiftyCount" StringFormat="🎯 50/50 ({0})"/>
                </Button.Text>
            </Button>

            <!-- Double Points Hint -->
            <Button Grid.Column="1"
                    Command="{Binding UseDoublePointsCommand}"
                    IsEnabled="{Binding HasDoublePoints}"
                    BackgroundColor="#1A1A1A"
                    TextColor="#f1c40f"
                    CornerRadius="15"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    BorderColor="#333"
                    BorderWidth="1">
                <Button.Text>
                    <Binding Path="DoublePointsCount" StringFormat="✨ 2x Points ({0})"/>
                </Button.Text>
            </Button>
        </Grid>

    </Grid>

</ContentPage>
