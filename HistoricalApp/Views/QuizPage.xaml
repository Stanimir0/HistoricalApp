<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:HistoricalApp.ViewModels"
             x:Class="HistoricalApp.Views.QuizPage"
             BackgroundColor="#1e1e1e"
             Title="Quiz">

    <ContentPage.BindingContext>
        <viewmodels:QuizPlayViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="20" Spacing="20">

        <Label Text="{Binding CurrentQuizTitle}"
               FontSize="24"
               FontAttributes="Bold"
               TextColor="#FFD700"
               HorizontalOptions="Center" />

        <Frame BackgroundColor="#2a2a2a" Padding="20" CornerRadius="20">
            <VerticalStackLayout Spacing="15">
                <Label Text="{Binding CurrentQuestion.Text}"
                       FontSize="20"
                       TextColor="White"
                       HorizontalOptions="Center" />

                <CollectionView ItemsSource="{Binding CurrentQuestion.Answers}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="10" Margin="0,5" BackgroundColor="#333" CornerRadius="10">
                                <Label Text="{Binding .}" TextColor="White">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:QuizPlayViewModel}}, Path=SelectAnswerCommand}" CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Text="Next"
                        Command="{Binding NextQuestionCommand}"
                        BackgroundColor="#007bff"
                        TextColor="White"
                        IsVisible="{Binding IsNextButtonVisible}" />
            </VerticalStackLayout>
        </Frame>

    </VerticalStackLayout>
</ContentPage>
