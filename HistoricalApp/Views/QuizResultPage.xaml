<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HistoricalApp.Views.QuizResultPage"
             BackgroundColor="#1e1e1e"
             Title="Results">

    <VerticalStackLayout Padding="20"
                         Spacing="15"
                         HorizontalOptions="Center"
                         VerticalOptions="Center">

        <Label Text="Quiz Complete!"
               FontSize="26"
               FontAttributes="Bold"
               TextColor="#FFD700"
               HorizontalOptions="Center" />

        <Label Text="{Binding ScoreText}"
               FontSize="18"
               TextColor="White"
               HorizontalOptions="Center" />

        <Label Text="{Binding PointsInfo}"
               FontSize="14"
               TextColor="#CCCCCC"
               HorizontalOptions="Center" />

        <Button Text="Back to Home"
                BackgroundColor="#FFD700"
                TextColor="#1E1E1E"
                CornerRadius="20"
                Clicked="OnBackHomeClicked"
                Margin="0,20,0,0"/>

        <Button Text="Play Another Quiz"
                BackgroundColor="#333333"
                TextColor="White"
                CornerRadius="20"
                Clicked="OnPlayAnotherClicked"/>

    </VerticalStackLayout>
</ContentPage>
