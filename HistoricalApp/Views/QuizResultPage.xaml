<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HistoricalApp.Views.QuizResultPage"
    BackgroundColor="#0E0E0E">

    <ScrollView>
        <VerticalStackLayout x:Name="RootLayout"
                             Padding="25"
                             Spacing="15"
                             VerticalOptions="Center">

            <!-- Title -->
            <Label Text="{Binding Translations.QuizCompleted}"
                   FontSize="32"
                   TextColor="#f1c40f"
                   HorizontalOptions="Center"
                   FontAttributes="Bold"/>

            <!-- Stars Rating -->
            <Label Text="{Binding StarsText}"
                   FontSize="40"
                   HorizontalOptions="Center"
                   Margin="0,0,0,5"/>

            <!-- Score Card -->
            <Border StrokeShape="RoundRectangle 18"
                    StrokeThickness="1"
                    Stroke="#333"
                    BackgroundColor="#1A1A1A"
                    Padding="20">
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Label Text="{Binding ScoreText}"
                           FontSize="24"
                           TextColor="White"
                           HorizontalOptions="Center"
                           FontAttributes="Bold"/>
                    <Label Text="{Binding AccuracyText}"
                           FontSize="16"
                           TextColor="#aaa"
                           HorizontalOptions="Center"/>
                    <Label Text="{Binding PointsInfo}"
                           FontSize="14"
                           TextColor="#888"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <!-- Level Up Banner -->
            <Border StrokeShape="RoundRectangle 15"
                    StrokeThickness="2"
                    Stroke="#FFD700"
                    BackgroundColor="#33FFD700"
                    Padding="20"
                    IsVisible="{Binding ShowLevelUp}">
                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                    <Label Text="{Binding Translations.LevelUp}"
                           FontSize="22"
                           TextColor="#FFD700"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>
                    <Label Text="{Binding LevelUpText}"
                           FontSize="16"
                           TextColor="White"
                           HorizontalOptions="Center"/>
                    <Label Text="{Binding LevelUpCoins}"
                           FontSize="14"
                           TextColor="#4CAF50"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <!-- Streak Banner -->
            <Border StrokeShape="RoundRectangle 15"
                    StrokeThickness="1"
                    Stroke="#FF9800"
                    BackgroundColor="#33FF9800"
                    Padding="15"
                    IsVisible="{Binding ShowStreak}">
                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Image Source="lightning_svgrepo_com.svg" 
                           HeightRequest="24" 
                           WidthRequest="24" 
                           VerticalOptions="Center"/>
                    <VerticalStackLayout>
                        <Label Text="{Binding StreakText}"
                               FontSize="16"
                               TextColor="#FF9800"
                               FontAttributes="Bold"/>
                        <Label Text="{Binding StreakBonusText}"
                               FontSize="13"
                               TextColor="#aaa"
                               IsVisible="{Binding ShowStreakBonus}"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <!-- Mission Coins -->
            <Border StrokeShape="RoundRectangle 15"
                    StrokeThickness="1"
                    Stroke="#4CAF50"
                    BackgroundColor="#334CAF50"
                    Padding="15"
                    IsVisible="{Binding ShowMissionCoins}">
                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Image Source="achivement_business_mission_svgrepo_com.svg" 
                           HeightRequest="20" 
                           WidthRequest="20" 
                           VerticalOptions="Center"/>
                    <Label Text="{Binding MissionCoinsText}"
                           FontSize="16"
                           TextColor="#4CAF50"
                           FontAttributes="Bold"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>

            <!-- Secret Badge Earned -->
            <Border StrokeShape="RoundRectangle 15"
                    StrokeThickness="2"
                    Stroke="#9C27B0"
                    BackgroundColor="#339C27B0"
                    Padding="20"
                    IsVisible="{Binding ShowSecretBadge}">
                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                    <Label Text="{Binding Translations.SecretBadgeUnlocked}"
                           FontSize="18"
                           TextColor="#CE93D8"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>
                    <Label Text="{Binding SecretBadgeDisplay}"
                           FontSize="36"
                           HorizontalOptions="Center"/>
                    <Label Text="{Binding SecretBadgeNameText}"
                           FontSize="16"
                           TextColor="White"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <!-- Double Points Used -->
            <Label Text="{Binding Translations.DoublePointsWereActive}"
                   FontSize="14"
                   TextColor="#FFD700"
                   HorizontalOptions="Center"
                   IsVisible="{Binding WasDoublePoints}"/>

            <!-- Buttons -->
            <Button Text="{Binding Translations.BackToHome}"
                    Clicked="OnBackHomeClicked"
                    BackgroundColor="#f1c40f"
                    TextColor="Black"
                    CornerRadius="15"
                    HeightRequest="55"
                    FontAttributes="Bold"
                    Margin="0,10,0,0"/>

            <Button Text="{Binding Translations.PlayAnotherQuiz}"
                    Clicked="OnPlayAnotherClicked"
                    BackgroundColor="#1A1A1A"
                    TextColor="#f1c40f"
                    CornerRadius="15"
                    HeightRequest="55"
                    BorderColor="#333"
                    BorderWidth="1"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
