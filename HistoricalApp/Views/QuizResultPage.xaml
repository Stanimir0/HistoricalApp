<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HistoricalApp.Views.QuizResultPage"
    BackgroundColor="#0E0E0E">

    <VerticalStackLayout x:Name="RootLayout"
                         Padding="25"
                         Spacing="20"
                         VerticalOptions="Center">

        <Label Text="Quiz Completed!"
               FontSize="32"
               TextColor="#f1c40f"
               HorizontalOptions="Center"
               FontAttributes="Bold"/>

        <Label Text="{Binding ScoreText}"
               FontSize="26"
               TextColor="White"
               HorizontalOptions="Center"/>

        <Label Text="{Binding PointsInfo}"
               FontSize="20"
               TextColor="#aaaaaa"
               HorizontalOptions="Center"/>

        <Button Text="Back to Home"
                Clicked="OnBackHomeClicked"
                BackgroundColor="#f1c40f"
                TextColor="Black"
                CornerRadius="15"
                HeightRequest="55"/>

        <Button Text="Play Another Quiz"
                Clicked="OnPlayAnotherClicked"
                BackgroundColor="#1A1A1A"
                TextColor="#f1c40f"
                CornerRadius="15"
                HeightRequest="55"/>

    </VerticalStackLayout>
</ContentPage>
