<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HistoricalApp.ViewModels"
             xmlns:helpers="clr-namespace:HistoricalApp.Helpers"
             x:Class="HistoricalApp.Views.RegisterPage"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.BindingContext>
        <vm:RegisterViewModel />
    </ContentPage.BindingContext>

    <Grid>
        <BoxView Color="{StaticResource BackgroundMain}" />

        <ScrollView>
            <VerticalStackLayout Spacing="25" Padding="30" VerticalOptions="Center" 
                                 x:Name="RootLayout" Opacity="0" TranslationY="100">

                <Label Text="{Binding Translations.JoinUs}" 
                       Style="{StaticResource Headline}" 
                       TextColor="{StaticResource Primary}"
                       Margin="0,0,0,10"/>
                
                <Label Text="{Binding Translations.CreateYourAccount}" 
                       Style="{StaticResource SubHeadline}" 
                       Margin="0,0,0,30"/>

                <!-- Register Form Card -->
                <Frame Style="{StaticResource Frame}" Padding="20,30">
                    <VerticalStackLayout Spacing="15">
                        
                        <Label Text="{Binding Translations.Email}" TextColor="{StaticResource TextSecondary}"/>
                        <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource PrimaryDark}" StrokeThickness="1" BackgroundColor="{StaticResource Surface}">
                            <Entry Placeholder="{Binding Translations.EmailPlaceholder}" 
                                   Text="{Binding Email}" 
                                   Keyboard="Email"
                                   TextColor="{StaticResource TextPrimary}"
                                   PlaceholderColor="{StaticResource TextSecondary}"
                                   BackgroundColor="Transparent"/>
                        </Border>

                        <Label Text="{Binding Translations.Password}" TextColor="{StaticResource TextSecondary}" Margin="0,10,0,0"/>
                        <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource PrimaryDark}" StrokeThickness="1" BackgroundColor="{StaticResource Surface}">
                            <Entry Placeholder="{Binding Translations.ChoosePasswordPlaceholder}" 
                                   Text="{Binding Password}" 
                                   IsPassword="True"
                                   TextColor="{StaticResource TextPrimary}"
                                   PlaceholderColor="{StaticResource TextSecondary}"
                                   BackgroundColor="Transparent"/>
                        </Border>
                        
                        <Label Text="{Binding Translations.ConfirmPassword}" TextColor="{StaticResource TextSecondary}" Margin="0,10,0,0"/>
                        <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource PrimaryDark}" StrokeThickness="1" BackgroundColor="{StaticResource Surface}">
                            <Entry Placeholder="{Binding Translations.ConfirmPasswordPlaceholder}" 
                                   Text="{Binding ConfirmPassword}" 
                                   IsPassword="True"
                                   TextColor="{StaticResource TextPrimary}"
                                   PlaceholderColor="{StaticResource TextSecondary}"
                                   BackgroundColor="Transparent"/>
                        </Border>

                        <Button Text="{Binding Translations.Register}" 
                                Command="{Binding RegisterCommand}" 
                                Clicked="OnRegisterClicked"
                                Margin="0,20,0,0"/>

                    </VerticalStackLayout>
                </Frame>

                <Button Text="{Binding Translations.BackToLogin}" 
                        Style="{StaticResource SecondaryButton}" 
                        Command="{Binding GoToLoginCommand}" 
                        Clicked="OnBackToLoginClicked"
                        Margin="0,10,0,0"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>

